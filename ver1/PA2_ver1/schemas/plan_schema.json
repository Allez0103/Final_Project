{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PA2 plan v1",
  "type": "object",
  "required": ["id", "project_id", "base_group_id", "group_ids", "steps", "status", "input_snapshot_id", "settings_version"],
  "properties": {
    "id": {"type": "string"},
    "project_id": {"type": "string"},
    "base_group_id": {"type": "string"},
    "group_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "status": {"enum": ["COMPLETE", "REVIEW_REQUIRED", "PARTIAL", "NO_SOLUTION_WITHIN_BUDGET", "CANCELLED", "FAILED"]}
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["group_id", "step_index", "removal_direction", "assembly_direction", "travel_mm", "camera_mode"],
      "properties": {
        "removal_direction": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "assembly_direction": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "travel_mm": {"type": "number", "exclusiveMinimum": 0},
        "camera_roll_deg": {"type": "integer", "enum": [0, 90, 180, 270], "default": 0}
      }
    }
  }
}

